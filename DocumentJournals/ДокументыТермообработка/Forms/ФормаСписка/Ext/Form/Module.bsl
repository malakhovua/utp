
// ======================================================================
// Команда СтруктураПодчиненности — дерево подчиненности текущего документа.
// Открывает обработку ИерархияДокументовДерево с документом-параметром. // + claude
&НаКлиенте
Процедура СтруктураПодчиненности(Команда)

	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Предупреждение("Не выбран документ в списке!");
		Возврат;
	КонецЕсли; // нет текущей строки

	Если НЕ ЗначениеЗаполнено(ТекущиеДанные.Ссылка) Тогда
		Возврат;
	КонецЕсли; // пустая ссылка

	ОткрытьФорму("Обработка.ИерархияДокументовДерево.Форма.ФормаУФ",
		Новый Структура("Документ", ТекущиеДанные.Ссылка), ЭтаФорма);

КонецПроцедуры // СтруктураПодчиненности() // + claude
