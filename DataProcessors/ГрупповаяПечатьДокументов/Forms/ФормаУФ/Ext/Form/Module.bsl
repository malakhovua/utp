// Имя файла накладной в формате ВН_Номер_Дата.xlsx
&НаСервереБезКонтекста
Функция ИмяФайлаНакладной(ДокументСсылка)

	ИмяФайла = "ВН_" + СокрЛП(ДокументСсылка.Номер) + "_" + Формат(ДокументСсылка.Дата, "ДФ=yyyy-MM-dd") + ".xlsx";

	// Заменяем символы, недопустимые в имени файла
	НедопустимыеСимволы = "\/:*?""<>|"; // символы, запрещенные в именах файлов
	Для НомерСимвола = 1 По СтрДлина(НедопустимыеСимволы) Цикл
		ИмяФайла = СтрЗаменить(ИмяФайла, Сред(НедопустимыеСимволы, НомерСимвола, 1), "_");
	КонецЦикла; // по недопустимым символам

	Возврат ИмяФайла;

КонецФункции // ИмяФайлаНакладной // + claude

#КонецОбласти
