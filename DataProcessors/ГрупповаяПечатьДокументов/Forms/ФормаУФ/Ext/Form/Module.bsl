// Модуль формы обработки ГрупповаяПечатьДокументов // + claude
// Групповая печать расходных накладных (РеализацияТоваровУслуг) в файлы Excel:
//  - каждая отмеченная накладная сохраняется в отдельный файл ВН_Номер_Дата.xlsx;
//  - сводная накладная по всем отмеченным документам сохраняется в один файл.
// Формирование табличных документов выполняется в модуле менеджера обработки.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Период по умолчанию - текущий месяц. Сохраненные реквизиты формы
	// (период, контрагент, договор, каталог) восстанавливаются платформой из настроек.
	Период.Вариант = ВариантСтандартногоПериода.ЭтотМесяц;

	ПересчитатьИтогиСписка(СписокДокументов, ИтогСумма, ИтогСуммаОтмеченных); // + claude

КонецПроцедуры // ПриСозданииНаСервере // + claude

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура КаталогСохраненияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Диалог.Заголовок = НСтр("ru='Выберите каталог для сохранения файлов';uk='Виберіть каталог для збереження файлів'");
	Диалог.Каталог   = КаталогСохранения;

	Если Диалог.Выбрать() Тогда
		КаталогСохранения = Диалог.Каталог;
	КонецЕсли; // каталог выбран

КонецПроцедуры // КаталогСохраненияНачалоВыбора // + claude

&НаКлиенте
Процедура СписокДокументовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	// Двойной клик по строке (кроме колонки пометки) открывает документ
	Если Поле = Элементы.СписокДокументовПометка Тогда
		Возврат;
	КонецЕсли; // клик по пометке

	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.СписокДокументов.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено И ЗначениеЗаполнено(ТекущиеДанные.Документ) Тогда
		ОткрытьЗначение(ТекущиеДанные.Документ);
	КонецЕсли; // есть документ в строке

КонецПроцедуры // СписокДокументовВыбор // + claude

// + claude
&НаКлиенте
Процедура СписокДокументовПометкаПриИзменении(Элемент)

	ПересчитатьИтоги();

КонецПроцедуры // СписокДокументовПометкаПриИзменении // + claude

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Заполнить(Команда)

	Если Не ЗначениеЗаполнено(Период.ДатаОкончания) Тогда
		Сообщить(НСтр("ru='Не задан период!';uk='Не задано період!'"));
		Возврат;
	КонецЕсли; // период не задан

	Если Период.ДатаНачала > Период.ДатаОкончания Тогда
		Сообщить(НСтр("ru='Дата начала периода больше даты окончания!';uk='Дата початку періоду більша за дату закінчення!'"));
		Возврат;
	КонецЕсли; // неверный период

	ЗаполнитьНаСервере();
	ПересчитатьИтоги(); // + claude

	Если СписокДокументов.Количество() = 0 Тогда
		Сообщить(НСтр("ru='Документы по заданному отбору не найдены.';uk='Документи за заданим відбором не знайдено.'"));
	КонецЕсли; // ничего не найдено

КонецПроцедуры // Заполнить // + claude

// Стандартный диалог выбора периода
&НаКлиенте
Процедура ВыбратьПериод(Команда)

	Диалог = Новый ДиалогРедактированияСтандартногоПериода;
	Диалог.Период = Период;
	Если Диалог.Редактировать() Тогда
		Период = Диалог.Период;
	КонецЕсли; // период выбран

КонецПроцедуры // ВыбратьПериод // + claude

&НаКлиенте
Процедура ВыбратьВсе(Команда)

	УстановитьПометки(Истина);

КонецПроцедуры // ВыбратьВсе // + claude

&НаКлиенте
Процедура СнятьВсе(Команда)

	УстановитьПометки(Ложь);

КонецПроцедуры // СнятьВсе // + claude

&НаКлиенте
Процедура ПечатьНакладныхВФайлы(Команда)

	Если Не ПроверитьКаталогСохранения() Тогда
		Возврат;
	КонецЕсли; // каталог не задан

	МассивДокументов = ОтмеченныеДокументы();
	Если МассивДокументов.Количество() = 0 Тогда
		Сообщить(НСтр("ru='Не отмечено ни одного документа.';uk='Не позначено жодного документа.'"));
		Возврат;
	КонецЕсли; // нет отмеченных документов

	// Формируем печатные формы по каждому документу на сервере
	МассивПечатныхФорм = СформироватьНакладныеНаСервере(МассивДокументов);

	КоличествоСохраненных = 0; // счетчик успешно сохраненных файлов
	Для Каждого ПечатнаяФорма Из МассивПечатныхФорм Цикл
		Если СохранитьТабличныйДокумент(ПечатнаяФорма.ТабДокумент, ПечатнаяФорма.ИмяФайла) Тогда
			КоличествоСохраненных = КоличествоСохраненных + 1;
		КонецЕсли; // файл сохранен
	КонецЦикла; // по печатным формам

	Сообщить(НСтр("ru='Сохранено файлов: ';uk='Збережено файлів: '") + КоличествоСохраненных
		+ НСтр("ru=' из ';uk=' з '") + МассивДокументов.Количество()
		+ НСтр("ru='. Каталог: ';uk='. Каталог: '") + КаталогСохранения);

КонецПроцедуры // ПечатьНакладныхВФайлы // + claude

&НаКлиенте
Процедура ПечатьСводнойНакладной(Команда)

	Если Не ПроверитьКаталогСохранения() Тогда
		Возврат;
	КонецЕсли; // каталог не задан

	МассивДокументов = ОтмеченныеДокументы();
	Если МассивДокументов.Количество() = 0 Тогда
		Сообщить(НСтр("ru='Не отмечено ни одного документа.';uk='Не позначено жодного документа.'"));
		Возврат;
	КонецЕсли; // нет отмеченных документов

	ТекстОшибки = ПроверитьДокументыДляСводнойНакладной(МассивДокументов);
	Если Не ПустаяСтрока(ТекстОшибки) Тогда
		Сообщить(ТекстОшибки);
		Возврат;
	КонецЕсли; // документы нельзя объединить

	ПечатнаяФорма = СформироватьСводнуюНакладнуюНаСервере(МассивДокументов);

	Если СохранитьТабличныйДокумент(ПечатнаяФорма.ТабДокумент, ПечатнаяФорма.ИмяФайла) Тогда
		Сообщить(НСтр("ru='Сводная накладная сохранена: ';uk='Зведену накладну збережено: '")
			+ ПолноеИмяФайла(ПечатнаяФорма.ИмяФайла));
	КонецЕсли; // файл сохранен

КонецПроцедуры // ПечатьСводнойНакладной // + claude

// + claude
// Выгрузка отмеченных накладных в CSV-файл плана поставки (DeliveryPlan)
// по п. 2.2.2 инструкции по обмену с ПП "Галактика"
&НаКлиенте
Процедура ВыгрузкаПланаПоставкиCSV(Команда)

	Если Не ПроверитьКаталогСохранения() Тогда
		Возврат;
	КонецЕсли; // каталог не задан

	МассивДокументов = ОтмеченныеДокументы();
	Если МассивДокументов.Количество() = 0 Тогда
		Сообщить(НСтр("ru='Не отмечено ни одного документа.';uk='Не позначено жодного документа.'"));
		Возврат;
	КонецЕсли; // нет отмеченных документов

	ТекстCSV = СформироватьПланПоставкиCSVНаСервере(МассивДокументов);
	Если СтрЧислоСтрок(ТекстCSV) <= 1 Тогда
		Сообщить(НСтр("ru='В отмеченных документах нет товаров для выгрузки.';uk='У позначених документах немає товарів для вивантаження.'"));
		Возврат;
	КонецЕсли; // только заголовок

	ПутьКФайлу = ПолноеИмяФайла("DeliveryPlan_44119819_" + Формат(ТекущаяДата(), "ДФ=dd_MM_yyyy") + ".csv");

	ТекстовыйФайл = Новый ТекстовыйДокумент;
	ТекстовыйФайл.УстановитьТекст(ТекстCSV);

	Попытка
		ТекстовыйФайл.Записать(ПутьКФайлу, КодировкаТекста.UTF8);
	Исключение
		Сообщить(НСтр("ru='Ошибка записи файла ';uk='Помилка запису файлу '") + ПутьКФайлу + ": "
			+ ОписаниеОшибки());
		Возврат;
	КонецПопытки; // запись файла

	Сообщить(НСтр("ru='Выгружено строк: ';uk='Вивантажено рядків: '") + (СтрЧислоСтрок(ТекстCSV) - 1)
		+ НСтр("ru='. Файл: ';uk='. Файл: '") + ПутьКФайлу);

	Если ОткрыватьПослеСохранения Тогда
		ЗапуститьПриложение(ПутьКФайлу);
	КонецЕсли; // открыть файл после записи

КонецПроцедуры // ВыгрузкаПланаПоставкиCSV // + claude

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьНаСервере()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ИСТИНА КАК Пометка,
	|	РеализацияТоваровУслуг.Ссылка КАК Документ,
	|	РеализацияТоваровУслуг.Организация КАК Организация,
	|	РеализацияТоваровУслуг.Контрагент КАК Контрагент,
	|	РеализацияТоваровУслуг.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	РеализацияТоваровУслуг.Склад КАК Склад,
	|	РеализацияТоваровУслуг.СуммаДокумента КАК Сумма
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	|ГДЕ
	|	РеализацияТоваровУслуг.Проведен
	|	И РеализацияТоваровУслуг.Дата МЕЖДУ &НачДата И &КонДата
	|	И (&БезОтбораПоКонтрагенту
	|			ИЛИ РеализацияТоваровУслуг.Контрагент = &Контрагент)
	|	И (&БезОтбораПоДоговору
	|			ИЛИ РеализацияТоваровУслуг.ДоговорКонтрагента = &ДоговорКонтрагента)
	|
	|УПОРЯДОЧИТЬ ПО
	|	РеализацияТоваровУслуг.Дата,
	|	РеализацияТоваровУслуг.Ссылка";

	Запрос.УстановитьПараметр("НачДата",                НачалоДня(Период.ДатаНачала));
	Запрос.УстановитьПараметр("КонДата",                КонецДня(Период.ДатаОкончания));
	Запрос.УстановитьПараметр("Контрагент",             Контрагент);
	Запрос.УстановитьПараметр("ДоговорКонтрагента",     ДоговорКонтрагента);
	Запрос.УстановитьПараметр("БезОтбораПоКонтрагенту", Не ЗначениеЗаполнено(Контрагент));
	Запрос.УстановитьПараметр("БезОтбораПоДоговору",    Не ЗначениеЗаполнено(ДоговорКонтрагента));

	СписокДокументов.Загрузить(Запрос.Выполнить().Выгрузить());

КонецПроцедуры // ЗаполнитьНаСервере // + claude

&НаКлиенте
Процедура УстановитьПометки(ЗначениеПометки)

	Для Каждого СтрокаДокумента Из СписокДокументов Цикл
		СтрокаДокумента.Пометка = ЗначениеПометки;
	КонецЦикла; // по строкам списка

	ПересчитатьИтоги(); // + claude

КонецПроцедуры // УстановитьПометки // + claude

// + claude
// Пересчитывает итог по колонке Сумма (подвал таблицы)
// и текстовый итог по отмеченным строкам
&НаКлиентеНаСервереБезКонтекста
Процедура ПересчитатьИтогиСписка(СписокДокументов, ИтогСумма, ИтогСуммаОтмеченных)

	ИтогСумма          = 0; // сумма по всем строкам
	СуммаОтмеченных    = 0; // сумма по отмеченным строкам
	КоличествоОтмеченных = 0; // количество отмеченных строк

	Для Каждого СтрокаДокумента Из СписокДокументов Цикл
		ИтогСумма = ИтогСумма + СтрокаДокумента.Сумма;
		Если СтрокаДокумента.Пометка Тогда
			СуммаОтмеченных      = СуммаОтмеченных + СтрокаДокумента.Сумма;
			КоличествоОтмеченных = КоличествоОтмеченных + 1;
		КонецЕсли; // строка отмечена
	КонецЦикла; // по строкам списка

	ИтогСуммаОтмеченных = НСтр("ru='Отмечено документов: ';uk='Позначено документів: '")
		+ КоличествоОтмеченных + НСтр("ru=' из ';uk=' з '") + СписокДокументов.Количество()
		+ НСтр("ru=', на сумму: ';uk=', на суму: '") + Формат(СуммаОтмеченных, "ЧДЦ=2; ЧН=0,00");

КонецПроцедуры // ПересчитатьИтогиСписка // + claude

// + claude
&НаКлиенте
Процедура ПересчитатьИтоги()

	ПересчитатьИтогиСписка(СписокДокументов, ИтогСумма, ИтогСуммаОтмеченных);

КонецПроцедуры // ПересчитатьИтоги // + claude

&НаКлиенте
Функция ОтмеченныеДокументы()

	МассивДокументов = Новый Массив;
	Для Каждого СтрокаДокумента Из СписокДокументов Цикл
		Если СтрокаДокумента.Пометка И ЗначениеЗаполнено(СтрокаДокумента.Документ) Тогда
			МассивДокументов.Добавить(СтрокаДокумента.Документ);
		КонецЕсли; // строка отмечена
	КонецЦикла; // по строкам списка

	Возврат МассивДокументов;

КонецФункции // ОтмеченныеДокументы // + claude

// Проверяет, что все отмеченные документы относятся к одной организации и одному контрагенту.
// Возвращает текст ошибки или пустую строку.
&НаКлиенте
Функция ПроверитьДокументыДляСводнойНакладной(МассивДокументов)

	ПерваяОрганизация = Неопределено; // организация первого отмеченного документа
	ПервыйКонтрагент  = Неопределено; // контрагент первого отмеченного документа

	Для Каждого СтрокаДокумента Из СписокДокументов Цикл
		Если Не СтрокаДокумента.Пометка Тогда
			Продолжить;
		КонецЕсли; // строка не отмечена

		Если ПерваяОрганизация = Неопределено Тогда
			ПерваяОрганизация = СтрокаДокумента.Организация;
			ПервыйКонтрагент  = СтрокаДокумента.Контрагент;
		ИначеЕсли СтрокаДокумента.Организация <> ПерваяОрганизация Тогда
			Возврат НСтр("ru='Для сводной накладной все документы должны быть одной организации.';uk='Для зведеної накладної всі документи мають бути однієї організації.'");
		ИначеЕсли СтрокаДокумента.Контрагент <> ПервыйКонтрагент Тогда
			Возврат НСтр("ru='Для сводной накладной все документы должны быть по одному контрагенту.';uk='Для зведеної накладної всі документи мають бути по одному контрагенту.'");
		КонецЕсли; // сравнение с первым документом
	КонецЦикла; // по строкам списка

	Возврат "";

КонецФункции // ПроверитьДокументыДляСводнойНакладной // + claude

&НаКлиенте
Функция ПроверитьКаталогСохранения()

	Если ПустаяСтрока(КаталогСохранения) Тогда
		Сообщить(НСтр("ru='Не выбран каталог для сохранения файлов!';uk='Не вибрано каталог для збереження файлів!'"));
		Возврат Ложь;
	КонецЕсли; // каталог не задан

	Каталог = Новый Файл(КаталогСохранения);
	Если Не Каталог.Существует() Тогда
		Сообщить(НСтр("ru='Каталог не существует: ';uk='Каталог не існує: '") + КаталогСохранения);
		Возврат Ложь;
	КонецЕсли; // каталога нет на диске

	Возврат Истина;

КонецФункции // ПроверитьКаталогСохранения // + claude

&НаКлиенте
Функция ПолноеИмяФайла(ИмяФайла)

	// Разделитель пути определяем по самому каталогу (клиент может быть Windows или Linux)
	Разделитель = ?(Найти(КаталогСохранения, "/") > 0, "/", "\");
	Если Прав(КаталогСохранения, 1) = Разделитель Тогда
		Возврат КаталогСохранения + ИмяФайла;
	КонецЕсли; // каталог уже заканчивается разделителем

	Возврат КаталогСохранения + Разделитель + ИмяФайла;

КонецФункции // ПолноеИмяФайла // + claude

// Записывает табличный документ в файл Excel в каталог сохранения на клиенте.
// Возвращает Истина при успешной записи.
&НаКлиенте
Функция СохранитьТабличныйДокумент(ТабДокумент, ИмяФайла)

	Если ТабДокумент = Неопределено Или ТабДокумент.ВысотаТаблицы = 0 Тогда
		Сообщить(НСтр("ru='Печатная форма не сформирована: ';uk='Друковану форму не сформовано: '") + ИмяФайла);
		Возврат Ложь;
	КонецЕсли; // пустой табличный документ

	ПутьКФайлу = ПолноеИмяФайла(ИмяФайла);

	Попытка
		ТабДокумент.Записать(ПутьКФайлу, ТипФайлаТабличногоДокумента.XLSX);
	Исключение
		Сообщить(НСтр("ru='Ошибка записи файла ';uk='Помилка запису файлу '") + ПутьКФайлу + ": "
			+ ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки; // запись файла

	Если ОткрыватьПослеСохранения Тогда
		ЗапуститьПриложение(ПутьКФайлу);
	КонецЕсли; // открыть файл после записи

	Возврат Истина;

КонецФункции // СохранитьТабличныйДокумент // + claude

// Формирует печатные формы по каждому документу.
// Возвращает массив структур с полями ТабДокумент, ИмяФайла.
&НаСервереБезКонтекста
Функция СформироватьНакладныеНаСервере(МассивДокументов)

	МассивПечатныхФорм = Новый Массив;

	Для Каждого ДокументСсылка Из МассивДокументов Цикл
		ПечатнаяФорма = Новый Структура;
		ПечатнаяФорма.Вставить("ТабДокумент", Обработки.ГрупповаяПечатьДокументов.СформироватьНакладную(ДокументСсылка));
		ПечатнаяФорма.Вставить("ИмяФайла",    ИмяФайлаНакладной(ДокументСсылка));
		МассивПечатныхФорм.Добавить(ПечатнаяФорма);
	КонецЦикла; // по документам

	Возврат МассивПечатныхФорм;

КонецФункции // СформироватьНакладныеНаСервере // + claude

// Формирует сводную накладную по массиву документов.
// Возвращает структуру с полями ТабДокумент, ИмяФайла.
&НаСервереБезКонтекста
Функция СформироватьСводнуюНакладнуюНаСервере(МассивДокументов)

	ДатаФормирования = ТекущаяДата(); // сводная накладная датируется текущей датой

	ПечатнаяФорма = Новый Структура;
	ПечатнаяФорма.Вставить("ТабДокумент", Обработки.ГрупповаяПечатьДокументов.СформироватьСводнуюНакладную(МассивДокументов, ДатаФормирования));
	ПечатнаяФорма.Вставить("ИмяФайла",    "ВН_Зведена_" + Формат(ДатаФормирования, "ДФ=yyyy-MM-dd_HHmmss") + ".xlsx");

	Возврат ПечатнаяФорма;

КонецФункции // СформироватьСводнуюНакладнуюНаСервере // + claude

