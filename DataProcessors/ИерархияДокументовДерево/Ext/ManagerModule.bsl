// Модуль менеджера обработки ИерархияДокументовДерево
// Логика перенесена из обработки ДеревоДокументов и глобальной процедуры
// глСформироватьДеревоДокументов (1С77). // + claude

// Формирует табличный документ с деревом подчиненности документов.
// Перенос СформироватьДерево() из 1С77: подъем к корню по реквизитам-документам,
// затем рекурсивный спуск по подчиненным с рисованием линий дерева. // + claude
Функция СформироватьДерево(ДокументСсылка) Экспорт

	// Контрагент исходного документа — фильтр при подъеме к корню (как в 1С77)
	ВыбКонтрагент = КонтрагентДокумента(ДокументСсылка);

	СписокЗащиты = Новый Соответствие; // защита от зацикливания, O(1) поиск // + claude
	КореньДок = НайтиКорень(ДокументСсылка, ВыбКонтрагент, СписокЗащиты);

	// Контекст обхода: строки дерева и кэш карты ссылающихся полей
	Контекст = Новый Структура;
	Контекст.Вставить("Строки",      Новый Массив);   // структуры: Текст, Ссылка, ЭтоТекущий, ПометкаУдаления
	Контекст.Вставить("Выведенные",  Новый Соответствие); // защита от зацикливания при спуске, O(1) поиск // + claude
	Контекст.Вставить("КартаПолей",  Новый Соответствие); // Тип -> массив описаний ссылающихся полей

	ВывестиУзел(Контекст, КореньДок, ДокументСсылка, "", Истина, Истина);

	Возврат СформироватьТабличныйДокумент(Контекст.Строки);

КонецФункции // СформироватьДерево // + claude

// Поиск корневого документа: подъем вверх по первому заполненному
// реквизиту шапки документного типа (перенос НайтиКорень из 1С77). // + claude
Функция НайтиКорень(Док, ВыбКонтрагент, СписокЗащиты)

	СписокЗащиты.Вставить(Док, Истина);

	КореньДок = Неопределено;
	МетаДок   = Док.Метаданные();

	Для Каждого Реквизит Из МетаДок.Реквизиты Цикл

		Значение = Док[Реквизит.Имя];
		Если НЕ ЭтоДокументнаяСсылка(Значение) Или НЕ ЗначениеЗаполнено(Значение) Тогда
			Продолжить;
		КонецЕсли; // не документная ссылка

		Если СписокЗащиты.Получить(Значение) <> Неопределено Тогда
			Продолжить;
		КонецЕсли; // уже проходили

		// Фильтр по контрагенту исходного документа (как в 1С77)
		Если ЗначениеЗаполнено(ВыбКонтрагент)
			И КонтрагентДокумента(Значение) <> ВыбКонтрагент Тогда
			Продолжить;
		КонецЕсли; // другой контрагент

		КореньДок = Значение;
		Прервать;

	КонецЦикла; // по реквизитам шапки

	Если КореньДок = Неопределено Тогда
		Возврат Док;
	Иначе
		Возврат НайтиКорень(КореньДок, ВыбКонтрагент, СписокЗащиты);
	КонецЕсли; // корень не найден — текущий и есть корень

КонецФункции // НайтиКорень // + claude

// Рекурсивный вывод узла дерева и его подчиненных
// (перенос ВывестиПодчиненные из 1С77; линии дерева — текстовыми префиксами). // + claude
Процедура ВывестиУзел(Контекст, Док, ТекущийДок, Префикс, ЭтоКорень, Последний)

	Если Контекст.Выведенные.Получить(Док) <> Неопределено Тогда
		Возврат;
	КонецЕсли; // защита от зацикливания
	Контекст.Выведенные.Вставить(Док, Истина);

	Если ЭтоКорень Тогда
		ТекстСтроки = ПредставлениеДокумента(Док);
	Иначе
		ТекстСтроки = Префикс + ?(Последний, "└─ ", "├─ ") + ПредставлениеДокумента(Док);
	КонецЕсли; // формирование текста строки

	СтрокаДерева = Новый Структура;
	СтрокаДерева.Вставить("Текст",           ТекстСтроки);
	СтрокаДерева.Вставить("Ссылка",          Док);
	СтрокаДерева.Вставить("ЭтоТекущий",      Док = ТекущийДок);
	СтрокаДерева.Вставить("ПометкаУдаления", Док.ПометкаУдаления);
	СтрокаДерева.Вставить("Проведен",        Док.Проведен); // + claude
	Контекст.Строки.Добавить(СтрокаДерева);

	Подчиненные = ПодчиненныеДокументы(Док, Контекст.КартаПолей);

	Для Ном = 0 По Подчиненные.ВГраница() Цикл

		ПодчиненныйДок = Подчиненные[Ном];
		Если ПодчиненныйДок = Док Тогда
			Продолжить;
		КонецЕсли; // ссылка на самого себя

		ПоследнийДочерний = (Ном = Подчиненные.ВГраница());
		НовыйПрефикс      = ?(ЭтоКорень, "", Префикс + ?(Последний, "   ", "│  "));
		ВывестиУзел(Контекст, ПодчиненныйДок, ТекущийДок, НовыйПрефикс, Ложь, ПоследнийДочерний);

	КонецЦикла; // по подчиненным

КонецПроцедуры // ВывестиУзел // + claude

// Подчиненные документы: документы, ссылающиеся на Док в реквизитах
// шапки или табличных частей (аналог ВыбратьПодчиненныеДокументы 1С77). // + claude
Функция ПодчиненныеДокументы(Док, КартаПолей)

	Результат = Новый Массив;

	ПоляИсточников = ПоляСсылающиесяНаТип(ТипЗнч(Док), КартаПолей);
	Если ПоляИсточников.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли; // никто не ссылается на этот тип

	// Собираем пакет запросов ОБЪЕДИНИТЬ по всем ссылающимся полям
	ТекстыЗапросов = Новый Массив;
	Для Каждого ОписаниеПоля Из ПоляИсточников Цикл

		Если ПустаяСтрока(ОписаниеПоля.ИмяТабличнойЧасти) Тогда
			ТекстыЗапросов.Добавить(
				"ВЫБРАТЬ
				|	Т" + Формат(ТекстыЗапросов.Количество(), "ЧГ=") + ".Ссылка КАК Ссылка,
				|	Т" + Формат(ТекстыЗапросов.Количество(), "ЧГ=") + ".Дата КАК Дата
				|ИЗ
				|	Документ." + ОписаниеПоля.ИмяДокумента + " КАК Т" + Формат(ТекстыЗапросов.Количество(), "ЧГ=") + "
				|ГДЕ
				|	Т" + Формат(ТекстыЗапросов.Количество(), "ЧГ=") + "." + ОписаниеПоля.ИмяПоля + " = &Док");
		Иначе
			ТекстыЗапросов.Добавить(
				"ВЫБРАТЬ
				|	Т" + Формат(ТекстыЗапросов.Количество(), "ЧГ=") + ".Ссылка КАК Ссылка,
				|	Т" + Формат(ТекстыЗапросов.Количество(), "ЧГ=") + ".Ссылка.Дата КАК Дата
				|ИЗ
				|	Документ." + ОписаниеПоля.ИмяДокумента + "." + ОписаниеПоля.ИмяТабличнойЧасти + "
				|		КАК Т" + Формат(ТекстыЗапросов.Количество(), "ЧГ=") + "
				|ГДЕ
				|	Т" + Формат(ТекстыЗапросов.Количество(), "ЧГ=") + "." + ОписаниеПоля.ИмяПоля + " = &Док");
		КонецЕсли; // шапка или табличная часть

	КонецЦикла; // по ссылающимся полям

	// РАЗЛИЧНЫЕ не нужен — дедупликация всё равно делается ниже по Соответствию,
	// поэтому используем ОБЪЕДИНИТЬ ВСЕ, чтобы не заставлять СУБД сортировать/схлопывать. // + claude
	ТекстЗапроса = "";
	Для Каждого Текст Из ТекстыЗапросов Цикл
		ТекстЗапроса = ТекстЗапроса + ?(ПустаяСтрока(ТекстЗапроса), "", "
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|") + Текст;
	КонецЦикла; // сборка пакета

	ТекстЗапроса = ТекстЗапроса + "
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата";

	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Док", Док);
	Выборка = Запрос.Выполнить().Выбрать();

	ВиденныеСсылки = Новый Соответствие; // O(1) дедуп вместо Массив.Найти // + claude
	Пока Выборка.Следующий() Цикл
		Если ВиденныеСсылки.Получить(Выборка.Ссылка) = Неопределено Тогда
			ВиденныеСсылки.Вставить(Выборка.Ссылка, Истина);
			Результат.Добавить(Выборка.Ссылка);
		КонецЕсли; // без дублей из разных полей
	КонецЦикла; // по выборке

	Возврат Результат;

КонецФункции // ПодчиненныеДокументы // + claude

// Карта полей всех документов конфигурации, ссылающихся на заданный тип.
// Строится лениво по одному разу на тип и кэшируется в КартаПолей. // + claude
Функция ПоляСсылающиесяНаТип(ТипСсылки, КартаПолей)

	Поля = КартаПолей.Получить(ТипСсылки);
	Если Поля <> Неопределено Тогда
		Возврат Поля;
	КонецЕсли; // уже в кэше

	Поля = Новый Массив;

	Для Каждого МетаДок Из Метаданные.Документы Цикл

		Для Каждого Реквизит Из МетаДок.Реквизиты Цикл
			Если Реквизит.Тип.СодержитТип(ТипСсылки) Тогда
				ОписаниеПоля = Новый Структура;
				ОписаниеПоля.Вставить("ИмяДокумента",        МетаДок.Имя);
				ОписаниеПоля.Вставить("ИмяТабличнойЧасти",   "");
				ОписаниеПоля.Вставить("ИмяПоля",             Реквизит.Имя);
				Поля.Добавить(ОписаниеПоля);
			КонецЕсли; // реквизит ссылается на тип
		КонецЦикла; // по реквизитам шапки

		Для Каждого ТабличнаяЧасть Из МетаДок.ТабличныеЧасти Цикл
			Для Каждого Реквизит Из ТабличнаяЧасть.Реквизиты Цикл
				Если Реквизит.Тип.СодержитТип(ТипСсылки) Тогда
					ОписаниеПоля = Новый Структура;
					ОписаниеПоля.Вставить("ИмяДокумента",      МетаДок.Имя);
					ОписаниеПоля.Вставить("ИмяТабличнойЧасти", ТабличнаяЧасть.Имя);
					ОписаниеПоля.Вставить("ИмяПоля",           Реквизит.Имя);
					Поля.Добавить(ОписаниеПоля);
				КонецЕсли; // реквизит ТЧ ссылается на тип
			КонецЦикла; // по реквизитам ТЧ
		КонецЦикла; // по табличным частям

	КонецЦикла; // по документам метаданных

	КартаПолей.Вставить(ТипСсылки, Поля);
	Возврат Поля;

КонецФункции // ПоляСсылающиесяНаТип // + claude

// Представление документа: вид, номер, дата, маркеры состояния и сумма
// (перенос ПредставлениеДокумента + ПолучитьСуммуСтрокой из 1С77). // + claude
Функция ПредставлениеДокумента(Док)

	МетаДок = Док.Метаданные();

	ПечДок = МетаДок.Представление() + " № " + Док.Номер
		+ " от " + Формат(Док.Дата, "ДФ=dd.MM.yyyy HH:mm:ss");

	Если Док.ПометкаУдаления Тогда
		ПечДок = ПечДок + " (Пометка удаления!)";
	ИначеЕсли НЕ Док.Проведен Тогда
		ПечДок = ПечДок + " (Не проведен!)";
	КонецЕсли; // маркер состояния

	// Сумма документа — по стандартным реквизитам УТП
	Если МетаДок.Реквизиты.Найти("СуммаДокумента") <> Неопределено Тогда
		СуммаДок = Док["СуммаДокумента"];
		Если ЗначениеЗаполнено(СуммаДок) Тогда
			ПечВал = "";
			Если МетаДок.Реквизиты.Найти("ВалютаДокумента") <> Неопределено Тогда
				ПечВал = " " + СокрЛП(Док["ВалютаДокумента"]);
			КонецЕсли; // есть валюта
			ПечДок = ПечДок + " Сумма: " + Формат(СуммаДок, "ЧДЦ=2") + ПечВал;
		КонецЕсли; // сумма заполнена
	КонецЕсли; // есть реквизит суммы

	Возврат ПечДок;

КонецФункции // ПредставлениеДокумента // + claude

// Вывод собранных строк дерева в табличный документ
Функция СформироватьТабличныйДокумент(СтрокиДерева)

	ТабДок = Новый ТабличныйДокумент;

	ШрифтДерева  = Новый Шрифт("Courier New", 10);
	ШрифтТекущий = Новый Шрифт("Courier New", 10, Истина); // текущий — жирным

	// Заголовок
	Область        = ТабДок.Область(1, 1);
	Область.Текст  = "Структура подчиненных документов";
	Область.Шрифт  = Новый Шрифт("Arial", 12, Истина);

	НомерСтроки = 3;
	Для Каждого СтрокаДерева Из СтрокиДерева Цикл

		Область             = ТабДок.Область(НомерСтроки, 1);
		Область.Текст       = СтрокаДерева.Текст;
		Область.Расшифровка = СтрокаДерева.Ссылка;
		Область.Шрифт       = ?(СтрокаДерева.ЭтоТекущий, ШрифтТекущий, ШрифтДерева);

		Если СтрокаДерева.ПометкаУдаления Тогда
			Область.ЦветТекста = WebЦвета.Красный;
		ИначеЕсли НЕ СтрокаДерева.Проведен Тогда
			Область.ЦветТекста = WebЦвета.Зеленый;
		КонецЕсли; // помеченный на удаление — красным, не проведенный — зеленым // + claude

		НомерСтроки = НомерСтроки + 1;

	КонецЦикла; // по строкам дерева

	ТабДок.Область(, 1, , 1).ШиринаКолонки = 120;
	ТабДок.ТолькоПросмотр = Истина;

	Возврат ТабДок;

КонецФункции // СформироватьТабличныйДокумент // + claude

// Контрагент документа или пустая ссылка, если реквизита нет
Функция КонтрагентДокумента(Док)

	Если Док.Метаданные().Реквизиты.Найти("Контрагент") <> Неопределено Тогда
		Возврат Док["Контрагент"];
	КонецЕсли; // есть реквизит Контрагент

	Возврат Справочники.Контрагенты.ПустаяСсылка();

КонецФункции // КонтрагентДокумента // + claude

// Проверка: значение — ссылка на документ
Функция ЭтоДокументнаяСсылка(Значение)

	Возврат Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(Значение));

КонецФункции // ЭтоДокументнаяСсылка // + claude
