// Модуль формы обработки ИерархияДокументовДерево
// Логика перенесена из формы обработки ДеревоДокументов (1С77).
// Дерево выводится в поле табличного документа на форме; при изменении
// документа или по команде Сформировать вывод переформировывается. // + claude

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Аналог ПриОткрытии() 1С77: если передан документ — сразу строим дерево
	Если Параметры.Свойство("Документ") И ЗначениеЗаполнено(Параметры.Документ) Тогда
		ВыбДокумент = Параметры.Документ;
		СформироватьНаСервере();
	КонецЕсли; // передан документ

КонецПроцедуры // ПриСозданииНаСервере // + claude

// Команда формирования дерева подчиненности
&НаКлиенте
Процедура Сформировать(Команда)

	Если НЕ ЗначениеЗаполнено(ВыбДокумент) Тогда
		Сообщить("Не указан документ для построения структуры подчиненности!");
		Возврат;
	КонецЕсли; // документ не указан

	СформироватьНаСервере();

КонецПроцедуры // Сформировать // + claude

// При изменении документа — переформировываем вывод дерева
&НаКлиенте
Процедура ВыбДокументПриИзменении(Элемент)

	Если ЗначениеЗаполнено(ВыбДокумент) Тогда
		СформироватьНаСервере();
	Иначе
		ОчиститьДеревоНаСервере();
	КонецЕсли; // документ выбран/очищен

КонецПроцедуры // ВыбДокументПриИзменении // + claude

// Формирует дерево подчиненности и выводит его в поле на форме
&НаСервере
Процедура СформироватьНаСервере()

	ТабДокумент = Обработки.ИерархияДокументовДерево.СформироватьДерево(ВыбДокумент);

	ДеревоТабДок.Очистить();
	ДеревоТабДок.Вывести(ТабДокумент);
	ДеревоТабДок.Область(, 1, , 1).ШиринаКолонки = 120; // ширина не переносится при Вывести
	ДеревоТабДок.ТолькоПросмотр = Истина;

КонецПроцедуры // СформироватьНаСервере // + claude

// Очищает поле вывода дерева
&НаСервере
Процедура ОчиститьДеревоНаСервере()

	ДеревоТабДок.Очистить();

КонецПроцедуры // ОчиститьДеревоНаСервере // + claude
