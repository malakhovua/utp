// Модуль формы обработки ИерархияДокументовДерево
// Логика перенесена из формы обработки ДеревоДокументов (1С77). // + claude

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Аналог ПриОткрытии() 1С77: если передан документ — строим дерево и закрываемся
	Если Параметры.Свойство("Документ") И ЗначениеЗаполнено(Параметры.Документ) Тогда
		ВыбДокумент = Параметры.Документ;
		АвтоПечать  = Истина;
	КонецЕсли; // передан документ

КонецПроцедуры // ПриСозданииНаСервере // + claude

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// Аналог 1С77: при открытии с документом-параметром — вывод дерева и выход
	Если АвтоПечать Тогда
		ПоказатьДерево();
		Отказ = Истина; // форма не открывается — аналог СтатусВозврата(0) в 1С77
	КонецЕсли; // автопостроение по параметру

КонецПроцедуры // ПриОткрытии // + claude

// Команда формирования дерева подчиненности
&НаКлиенте
Процедура Сформировать(Команда)

	Если НЕ ЗначениеЗаполнено(ВыбДокумент) Тогда
		Сообщить("Не указан документ для построения структуры подчиненности!");
		Возврат;
	КонецЕсли; // документ не указан

	ПоказатьДерево();

КонецПроцедуры // Сформировать // + claude

// Формирует и показывает дерево подчиненности (аналог СформироватьДерево 1С77)
&НаКлиенте
Процедура ПоказатьДерево()

	ТабДокумент = СформироватьНаСервере();
	УниверсальныеМеханизмы.НапечататьДокумент(ТабДокумент, 1, Ложь, "Структура подчиненных документов", ВыбДокумент);

КонецПроцедуры // ПоказатьДерево // + claude

&НаСервере
Функция СформироватьНаСервере()

	Возврат Обработки.ИерархияДокументовДерево.СформироватьДерево(ВыбДокумент);

КонецФункции // СформироватьНаСервере // + claude
