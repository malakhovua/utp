// Команда объекта: дерево подчиненности документов термообработки.
// Аналог глСформироватьДеревоДокументов (1С77): открытие обработки
// с документом-параметром — дерево строится и показывается сразу. // + claude

&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)

	Если НЕ ЗначениеЗаполнено(ПараметрКоманды) Тогда
		Сообщить("Документ не записан!");
		Возврат;
	КонецЕсли; // документ не записан

	ОткрытьФорму("Обработка.ИерархияДокументовДерево.Форма.ФормаУФ",
		Новый Структура("Документ", ПараметрКоманды),
		ПараметрыВыполненияКоманды.Источник,
		ПараметрыВыполненияКоманды.Уникальность,
		ПараметрыВыполненияКоманды.Окно);

КонецПроцедуры // ОбработкаКоманды // + claude
