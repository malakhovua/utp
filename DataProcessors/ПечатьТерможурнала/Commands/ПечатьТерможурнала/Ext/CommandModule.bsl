// Команда объекта: печать терможурнала по документам ЗагрузкаКамеры.
// Доступна в командном интерфейсе форм документа ЗагрузкаКамеры. // + claude

&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)

	// РежимИспользованияПараметра = Множественный: параметр — массив ссылок
	СписокДокументов = Новый Массив;
	Если ТипЗнч(ПараметрКоманды) = Тип("Массив") Тогда
		Для Каждого Документ Из ПараметрКоманды Цикл
			СписокДокументов.Добавить(Документ);
		КонецЦикла; // по переданным ссылкам
	Иначе
		СписокДокументов.Добавить(ПараметрКоманды);
	КонецЕсли; // одиночная ссылка

	Если СписокДокументов.Количество() = 0 Тогда
		Сообщить("Не выбраны документы загрузки камеры!");
		Возврат;
	КонецЕсли; // пустой список

	ОткрытьФорму("Обработка.ПечатьТерможурнала.Форма.ФормаУФ",
		Новый Структура("СписокДокументов", СписокДокументов),
		ПараметрыВыполненияКоманды.Источник,
		ПараметрыВыполненияКоманды.Уникальность,
		ПараметрыВыполненияКоманды.Окно);

КонецПроцедуры // ОбработкаКоманды // + claude
