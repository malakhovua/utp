// Команда объекта: продолжение термообработки в следующей камере/подпрограмме
// (создание ЗагрузкаКамеры на основании другой ЗагрузкаКамеры). Аналог 1С77
// (ВводНаОсновании, ветка УМК_ЗагрузкаКамеры). У каждой позиции ТМЦ может быть
// свой следующий этап обработки, поэтому при нескольких вариантах пользователь
// выбирает подпрограмму продолжения. Открывает НЕЗАПИСАННЫЙ документ —
// сохраняет пользователь. // + claude

&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)

	Если НЕ ЗначениеЗаполнено(ПараметрКоманды) Тогда
		Сообщить("Документ не записан!");
		Возврат;
	КонецЕсли; // документ не записан

	Варианты = ПолучитьВариантыПродолженияНаСервере(ПараметрКоманды);

	Если Варианты.Количество() = 0 Тогда
		Предупреждение("Для этой загрузки нет следующего этапа термообработки — обработка завершена.");
		Возврат;
	ИначеЕсли Варианты.Количество() = 1 Тогда
		ОткрытьПродолжениеЗагрузки(ПараметрКоманды, Варианты[0].Подпрограмма, ПараметрыВыполненияКоманды);
	Иначе
		СписокВыбора = Новый СписокЗначений;
		Для Каждого СтрокаВарианта Из Варианты Цикл
			СписокВыбора.Добавить(СтрокаВарианта.Подпрограмма,
				Строка(СтрокаВарианта.Подпрограмма) + " (" + Формат(СтрокаВарианта.КвоРам, "Ч12.0") + " рам)");
		КонецЦикла; // формирование списка вариантов
		ОписаниеОпов = Новый ОписаниеОповещения("ПродолжитьЗагрузкуЗавершение", ЭтотОбъект,
			Новый Структура("ИсходнаяЗагрузка, ПараметрыВыполненияКоманды", ПараметрКоманды, ПараметрыВыполненияКоманды));
		СписокВыбора.ПоказатьВыборЭлемента(ОписаниеОпов, "Выберите подпрограмму продолжения");
	КонецЕсли; // количество вариантов

КонецПроцедуры // ОбработкаКоманды() // + claude

&НаКлиенте
Процедура ПродолжитьЗагрузкуЗавершение(ВыбранныйЭлемент, ДопПараметры) Экспорт

	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли; // отмена выбора

	ОткрытьПродолжениеЗагрузки(ДопПараметры.ИсходнаяЗагрузка, ВыбранныйЭлемент.Значение, ДопПараметры.ПараметрыВыполненияКоманды);

КонецПроцедуры // ПродолжитьЗагрузкуЗавершение() // + claude

&НаКлиенте
Процедура ОткрытьПродолжениеЗагрузки(ИсходнаяЗагрузка, ВыбраннаяПодпрограмма, ПараметрыВыполненияКоманды)

	Основание = Новый Структура("ИсходнаяЗагрузка, Подпрограмма", ИсходнаяЗагрузка, ВыбраннаяПодпрограмма);

	ОткрытьФорму("Документ.ЗагрузкаКамеры.ФормаОбъекта",
		Новый Структура("Основание", Основание),
		ПараметрыВыполненияКоманды.Источник,
		ПараметрыВыполненияКоманды.Уникальность,
		ПараметрыВыполненияКоманды.Окно,,,
		РежимОткрытияОкнаФормы.Независимый);

КонецПроцедуры // ОткрытьПродолжениеЗагрузки() // + claude

&НаСервере
Функция ПолучитьВариантыПродолженияНаСервере(ИсходнаяЗагрузка)

	Возврат Документы.ЗагрузкаКамеры.ПолучитьВариантыПродолжения(ИсходнаяЗагрузка);

КонецФункции // ПолучитьВариантыПродолженияНаСервере() // + claude
