// Модуль формы документа ЗагрузкаКамеры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ОбновитьДекорации();
КонецПроцедуры // ПриСозданииНаСервере // + claude

// ======================================================================
// Округление вверх — аналог глОкрВверх из 1С77 // + claude
&НаСервереБезКонтекста
Функция ОкрВверх(Значение)

	Если Цел(Значение) = Значение Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат Цел(Значение) + 1;

КонецФункции // ОкрВверх()

// ======================================================================
// Итог рам по документу: свертка ТЧ по виду рам и округление вверх
// каждого вида — как в 1С77 (ВернутьКвоРам, ИтогРамПоДокументу) // + claude
&НаСервере
Функция ИтогоРамПоВидам()

	ТЗ = Объект.ТМЦ.Выгрузить();
	ТЗ.Свернуть("ВидРамы", "КвоРам");
	ИтРам = 0;
	Для Каждого Строка Из ТЗ Цикл
		ИтРам = ИтРам + ОкрВверх(Строка.КвоРам);
	КонецЦикла; // перебор видов рам

	Возврат ИтРам;

КонецФункции // ИтогоРамПоВидам()

// ======================================================================
// Декорации и доступность — аналог УстДоступность 1С77:
// видимость камеры/надписи ВНЕ КАМЕРЫ, итоги по количеству и рамам // + claude
&НаСервере
Процедура ОбновитьДекорации()

	// К-во рам в камере
	Если ЗначениеЗаполнено(Объект.КамераТермообработки) Тогда
		Элементы.КвоРамВКамере.Заголовок = "К-во рам в камере: " + Формат(Объект.КамераТермообработки.КоличествоРам, "ЧДц=0");
	Иначе
		Элементы.КвоРамВКамере.Заголовок = "К-во рам в камере: 0";
	КонецЕсли;

	// Итого к-во ТМЦ
	ИтогоКво = 0;
	Для Каждого Строка Из Объект.ТМЦ Цикл
		ИтогоКво = ИтогоКво + Строка.Кво;
	КонецЦикла;
	Элементы.ИтогоКвоТекст.Заголовок = "Итого к-во: " + Формат(ИтогоКво, "Ч12.2");

	// Итого рам (с округлением вверх по видам) и предупреждение о превышении
	ИтРам = ИтогоРамПоВидам();
	Элементы.ИтогоКвоРамТекст.Заголовок = "Итого к-во рам : " + СокрЛП(Формат(ИтРам, "Ч12.0"));

	Если ЗначениеЗаполнено(Объект.КамераТермообработки)
		И Объект.КамераТермообработки.КоличествоРам > 0
		И ИтРам > Объект.КамераТермообработки.КоличествоРам Тогда
		Элементы.ТекстМногоРам.Заголовок = "Выберите продукцию для загрузки в камеру, ПРЕВЫШЕНО количество рам";
	Иначе
		Элементы.ТекстМногоРам.Заголовок = "";
	КонецЕсли; // превышение количества рам

	// Видимость камеры и надписи ВНЕ КАМЕРЫ по подпрограмме
	ВнеКамеры = ЗначениеЗаполнено(Объект.ПодПрограмма) И Объект.ПодПрограмма.ВнеКамеры;
	Элементы.КамераТермообработки.Видимость = НЕ ВнеКамеры;
	Элементы.ВнеКамерыТекст.Видимость       = ВнеКамеры;

КонецПроцедуры // ОбновитьДекорации // + claude

&НаКлиенте
Процедура КамераТермообработкиПриИзменении(Элемент)
	КамераТермообработкиПриИзменении_НаСервере();
КонецПроцедуры // КамераТермообработкиПриИзменении // + claude

&НаСервере
Процедура КамераТермообработкиПриИзменении_НаСервере()
	ОбновитьДекорации();
КонецПроцедуры // КамераТермообработкиПриИзменении_НаСервере // + claude

// ======================================================================
// Пересчет итогов при любом изменении ТЧ ТМЦ (добавление/редактирование/
// удаление строки) — в 1С77 текст выводился постоянно, т.к. вычислялся
// при каждой перерисовке формы. В 8.3 пересчитываем по событиям ТЧ // + claude
&НаКлиенте
Процедура ТМЦПриИзменении(Элемент)
	ОбновитьДекорации();
КонецПроцедуры // ТМЦПриИзменении // + claude

&НаКлиенте
Процедура ТМЦПослеУдаления(Элемент)
	ОбновитьДекорации();
КонецПроцедуры // ТМЦПослеУдаления // + claude

&НаКлиенте
Процедура ПодПрограммаПриИзменении(Элемент)
	ПодПрограммаПриИзменении_НаСервере();
КонецПроцедуры // ПодПрограммаПриИзменении // + claude

&НаСервере
Процедура ПодПрограммаПриИзменении_НаСервере()
	// Пересчитываем время освобождения камеры
	РассчитатьВремяОсвобождения_НаСервере();

	// Очищаем камеру если подпрограмма выполняется вне камеры
	Если ЗначениеЗаполнено(Объект.ПодПрограмма) И Объект.ПодПрограмма.ВнеКамеры Тогда
		Объект.КамераТермообработки = Справочники.КамерыТермообработки.ПустаяСсылка();
	КонецЕсли;

	ОбновитьДекорации();
КонецПроцедуры // ПодПрограммаПриИзменении_НаСервере // + claude

// ======================================================================
// Изменение даты и времени загрузки — пересчет освобождения камеры,
// аналог ПересчетСвободна из 1С77 // + claude
&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	ПересчетСвободна_НаСервере();
КонецПроцедуры // ДатаПриИзменении // + claude

&НаКлиенте
Процедура ЗагруженаЧасыПриИзменении(Элемент)
	Если Объект.ЗагруженаЧасы > 23 Тогда
		Объект.ЗагруженаЧасы = 23;
	КонецЕсли;
	ПересчетСвободна_НаСервере();
КонецПроцедуры // ЗагруженаЧасыПриИзменении // + claude

&НаКлиенте
Процедура ЗагруженаМинутыПриИзменении(Элемент)
	Если Объект.ЗагруженаМинуты > 59 Тогда
		Объект.ЗагруженаМинуты = 59;
	КонецЕсли;
	ПересчетСвободна_НаСервере();
КонецПроцедуры // ЗагруженаМинутыПриИзменении // + claude

&НаСервере
Процедура ПересчетСвободна_НаСервере()
	ПроверкаВилкиВремени(Истина); // 1 - исправлять дату время, как в 1С77
	РассчитатьВремяОсвобождения_НаСервере();
	ОбновитьДекорации();
КонецПроцедуры // ПересчетСвободна_НаСервере // + claude

&НаСервере
Процедура РассчитатьВремяОсвобождения_НаСервере()
	Если НЕ ЗначениеЗаполнено(Объект.ПодПрограмма) Тогда
		Возврат;
	КонецЕсли;

	// ДлинаПроцесса хранится в минутах
	ТекМинутПрограммы = 0;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(ПроцессПодПрограммыТермообработки.ДлинаПроцесса), 0) КАК ТекМинутПрограммы
		|ИЗ
		|	Справочник.ПроцессПодПрограммыТермообработки КАК ПроцессПодПрограммыТермообработки
		|ГДЕ
		|	ПроцессПодПрограммыТермообработки.Владелец = &ПодПрограмма
		|	И НЕ ПроцессПодПрограммыТермообработки.ПометкаУдаления";
	Запрос.УстановитьПараметр("ПодПрограмма", Объект.ПодПрограмма);
	Результат = Запрос.Выполнить().Выбрать();
	Если Результат.Следующий() Тогда
		ТекМинутПрограммы = Результат.ТекМинутПрограммы;
	КонецЕсли; // выборка суммы длительности // + claude

	Объект.ЗанятаМинуты = ТекМинутПрограммы;

	// Рассчитываем дату и время освобождения камеры
	ОбщоМинут             = (Объект.ЗагруженаЧасы * 60) + Объект.ЗагруженаМинуты + Объект.ЗанятаМинуты;
	Объект.СвободнаДата   = НачалоДня(Объект.Дата) + Цел(ОбщоМинут / 1440) * 86400;
	ОстатокМинут          = ОбщоМинут - Цел(ОбщоМинут / 1440) * 1440;
	Объект.СвободнаЧасы  = Цел(ОстатокМинут / 60);
	Объект.СвободнаМинуты = ОстатокМинут - Цел(ОстатокМинут / 60) * 60;

КонецПроцедуры // РассчитатьВремяОсвобождения_НаСервере // + claude

// ======================================================================
// Проверка даты/времени загрузки в вилке Мин/Макс документа-основания.
// Возвращает Истина при ошибках; при ИсправлятьДатуВремя корректирует
// значения — аналог ПроверкаВилкиВремени 1С77 // + claude
&НаСервере
Функция ПроверкаВилкиВремени(ИсправлятьДатуВремя = Ложь)

	ЕстьОшибки = Ложь;

	Если НЕ ЗначениеЗаполнено(Объект.МинДата) И НЕ ЗначениеЗаполнено(Объект.МаксДата) Тогда
		Возврат ЕстьОшибки;
	КонецЕсли; // вилка не задана

	ДатаДок = НачалоДня(Объект.Дата);

	// Проверка превышения максимальной даты
	Если ЗначениеЗаполнено(Объект.МаксДата) И ДатаДок > Объект.МаксДата Тогда
		Сообщить("Дата загрузки превышает максимальную дату.");
		ЕстьОшибки = Истина;
		Если ИсправлятьДатуВремя Тогда
			Объект.Дата = Объект.МаксДата;
			ДатаДок = НачалоДня(Объект.Дата);
		КонецЕсли;
	КонецЕсли; // превышение максимальной даты

	// Проверка уменьшения минимальной даты
	Если ЗначениеЗаполнено(Объект.МинДата) И ДатаДок < Объект.МинДата Тогда
		Сообщить("Дата загрузки меньше минимальной даты.");
		ЕстьОшибки = Истина;
		Если ИсправлятьДатуВремя Тогда
			Объект.Дата = Объект.МинДата;
			ДатаДок = НачалоДня(Объект.Дата);
		КонецЕсли;
	КонецЕсли; // меньше минимальной даты

	// Проверка превышения максимального времени
	Если ДатаДок = Объект.МаксДата Тогда
		Если Объект.ЗагруженаЧасы > Объект.МаксЧасы Тогда
			Сообщить("Часы загрузки превышают максимальное время (часы) загрузки !");
			ЕстьОшибки = Истина;
			Если ИсправлятьДатуВремя Тогда
				Объект.ЗагруженаЧасы = Объект.МаксЧасы;
			КонецЕсли;
		ИначеЕсли Объект.ЗагруженаЧасы = Объект.МаксЧасы И Объект.ЗагруженаМинуты > Объект.МаксМинуты Тогда
			Сообщить("Минуты загрузки превышают максимальное время (минуты) загрузки !");
			ЕстьОшибки = Истина;
			Если ИсправлятьДатуВремя Тогда
				Объект.ЗагруженаМинуты = Объект.МаксМинуты;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли; // максимальное время

	// Проверка превышения минимального времени
	Если ДатаДок = Объект.МинДата Тогда
		Если Объект.ЗагруженаЧасы < Объект.МинЧасы Тогда
			Сообщить("Часы загрузки менее минимального времени (часы) загрузки !");
			ЕстьОшибки = Истина;
			Если ИсправлятьДатуВремя Тогда
				Объект.ЗагруженаЧасы = Объект.МинЧасы;
			КонецЕсли;
		ИначеЕсли Объект.ЗагруженаЧасы = Объект.МинЧасы И Объект.ЗагруженаМинуты < Объект.МинМинуты Тогда
			Сообщить("Минуты загрузки менее минимального времени (минуты) загрузки !");
			ЕстьОшибки = Истина;
			Если ИсправлятьДатуВремя Тогда
				Объект.ЗагруженаМинуты = Объект.МинМинуты;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли; // минимальное время

	Возврат ЕстьОшибки;

КонецФункции // ПроверкаВилкиВремени() // + claude

// ======================================================================
// Проверка пересечения интервалов загрузки выбранной камеры с другими
// документами — аналог ПроверкаПересечения 1С77 (только сообщения) // + claude
&НаСервере
Процедура ПроверкаПересечения()

	Если НЕ ЗначениеЗаполнено(Объект.КамераТермообработки) Тогда
		Возврат;
	КонецЕсли; // камера не выбрана

	НачПериода = ДобавитьМесяц(НачалоДня(Объект.Дата), -2);
	КонПериода = ДобавитьМесяц(НачалоДня(Объект.Дата), 2);

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЗагрузкаКамеры.Ссылка КАК Ссылка,
		|	ЗагрузкаКамеры.Дата КАК ДатаДок,
		|	ЗагрузкаКамеры.ЗагруженаЧасы КАК ЗагруженаЧасы,
		|	ЗагрузкаКамеры.ЗагруженаМинуты КАК ЗагруженаМинуты,
		|	ЗагрузкаКамеры.СвободнаДата КАК СвободнаДата,
		|	ЗагрузкаКамеры.СвободнаЧасы КАК СвободнаЧасы,
		|	ЗагрузкаКамеры.СвободнаМинуты КАК СвободнаМинуты,
		|	ЗагрузкаКамеры.КамераТермообработки КАК КамераТермообработки,
		|	ЗагрузкаКамеры.ПодПрограмма КАК ПодПрограмма
		|ИЗ
		|	Документ.ЗагрузкаКамеры КАК ЗагрузкаКамеры
		|ГДЕ
		|	ЗагрузкаКамеры.Дата МЕЖДУ &НачПериода И &КонПериода
		|	И ЗагрузкаКамеры.КамераТермообработки = &Камера
		|	И ЗагрузкаКамеры.ПометкаУдаления = ЛОЖЬ
		|	И ЗагрузкаКамеры.Ссылка <> &ТекущийДокумент
		|УПОРЯДОЧИТЬ ПО
		|	ЗагрузкаКамеры.Дата,
		|	ЗагрузкаКамеры.ЗагруженаЧасы,
		|	ЗагрузкаКамеры.ЗагруженаМинуты";
	Запрос.УстановитьПараметр("НачПериода",       НачПериода);
	Запрос.УстановитьПараметр("КонПериода",       КонецДня(КонПериода));
	Запрос.УстановитьПараметр("Камера",           Объект.КамераТермообработки);
	Запрос.УстановитьПараметр("ТекущийДокумент",  Объект.Ссылка);

	Выборка = Запрос.Выполнить().Выбрать();

	// Пересчет в минуты относительно начала периода
	МинутЗагрузкаЭтот = ((НачалоДня(Объект.Дата) - НачПериода) / 86400) * 1440
		+ Объект.ЗагруженаЧасы * 60 + Объект.ЗагруженаМинуты;
	МинутСвободнаЭтот = ((НачалоДня(Объект.СвободнаДата) - НачПериода) / 86400) * 1440
		+ Объект.СвободнаЧасы * 60 + Объект.СвободнаМинуты;

	Пока Выборка.Следующий() Цикл

		МинутЗагрузка = ((НачалоДня(Выборка.ДатаДок) - НачПериода) / 86400) * 1440
			+ Выборка.ЗагруженаЧасы * 60 + Выборка.ЗагруженаМинуты;
		МинутСвободна = ((НачалоДня(Выборка.СвободнаДата) - НачПериода) / 86400) * 1440
			+ Выборка.СвободнаЧасы * 60 + Выборка.СвободнаМинуты;

		ЕстьПересечение = Ложь;

		// Проверка пересечения Начала
		Если МинутЗагрузка < МинутЗагрузкаЭтот И МинутЗагрузкаЭтот < МинутСвободна Тогда
			ЕстьПересечение = Истина;
		КонецЕсли;

		// Проверка пересечения Конца
		Если МинутЗагрузка < МинутСвободнаЭтот И МинутСвободнаЭтот < МинутСвободна Тогда
			ЕстьПересечение = Истина;
		КонецЕсли;

		Если ЕстьПересечение Тогда
			Сообщить("Док № " + Объект.Номер + " от " + Формат(Объект.Дата, "ДФ=dd.MM.yy")
				+ " камера: " + Объект.КамераТермообработки
				+ " подпр.: " + Объект.ПодПрограмма
				+ " Есть пересечение с док. № " + Выборка.Ссылка
				+ " камера: " + Выборка.КамераТермообработки
				+ " подпр.: " + Выборка.ПодПрограмма);
		КонецЕсли; // есть пересечение

	КонецЦикла; // перебор документов камеры

КонецПроцедуры // ПроверкаПересечения() // + claude

// ======================================================================
// Возвращает Истина, если подпрограмма строки — последняя подпрограмма
// номенклатуры (процесс окончен) — аналог ВозвратОкончен 1С77 // + claude
&НаСервере
Функция ПроцессОкончен(Номенклатура)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ПодпрограммыНоменклатуры.Подпрограмма КАК Подпрограмма
		|ИЗ
		|	Справочник.ПодпрограммыНоменклатуры КАК ПодпрограммыНоменклатуры
		|ГДЕ
		|	ПодпрограммыНоменклатуры.Владелец = &Номенклатура
		|	И ПодпрограммыНоменклатуры.ПометкаУдаления = ЛОЖЬ
		|УПОРЯДОЧИТЬ ПО
		|	ПодпрограммыНоменклатуры.Код УБЫВ";
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Подпрограмма = Объект.ПодПрограмма;
	КонецЕсли; // есть подпрограммы номенклатуры

	Возврат Ложь;

КонецФункции // ПроцессОкончен() // + claude

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)

	// Проверка заполненности — как ПриЗаписи 1С77 // + claude
	Если НЕ ЗначениеЗаполнено(ТекущийОбъект.ПодПрограмма) Тогда
		Сообщить("Не заполнена подпрограмма обработки !!!");
		Отказ = Истина;
	ИначеЕсли НЕ ТекущийОбъект.ПодПрограмма.ВнеКамеры
		И НЕ ЗначениеЗаполнено(ТекущийОбъект.КамераТермообработки) Тогда
		Сообщить("Не заполнена КАМЕРА !!!");
		Отказ = Истина;
	КонецЕсли; // проверки подпрограммы и камеры

	// Проверка даты/времени в вилке
	Если ПроверкаВилкиВремени() Тогда
		Отказ = Истина;
	КонецЕсли; // вилка времени

	Если Отказ Тогда
		Сообщить("Документ не заполнен. Смотрите строку сообщений");
		Возврат;
	КонецЕсли; // есть ошибки

	// Пересечения по камере — только сообщения, запись не блокируют (как 1С77)
	Если ЗначениеЗаполнено(ТекущийОбъект.ПодПрограмма) И НЕ ТекущийОбъект.ПодПрограмма.ВнеКамеры Тогда
		ПроверкаПересечения();
	КонецЕсли; // проверка пересечений

	// Признак неоконченных процессов для журнала
	ТекущийОбъект.ЕстьНеоконченыеПроцессы = Ложь;
	Для Каждого Строка Из ТекущийОбъект.ТМЦ Цикл
		Если НЕ ПроцессОкончен(Строка.ТМЦ) Тогда
			ТекущийОбъект.ЕстьНеоконченыеПроцессы = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла; // перебор строк ТМЦ

	// Первая запись - время документа из ЗагруженаЧасы:ЗагруженаМинуты, как УстановитьВремя в 1С77
	Если НЕ ЗначениеЗаполнено(ТекущийОбъект.Ссылка) Тогда
		ТекущийОбъект.Дата = НачалоДня(ТекущийОбъект.Дата)
			+ ТекущийОбъект.ЗагруженаЧасы * 3600 + ТекущийОбъект.ЗагруженаМинуты * 60;
	КонецЕсли; // первая запись

	// Итог рам по документу с округлением вверх по видам рам
	ТЗ = ТекущийОбъект.ТМЦ.Выгрузить();
	ТЗ.Свернуть("ВидРамы", "КвоРам");
	ИтРам = 0;
	Для Каждого Строка Из ТЗ Цикл
		ИтРам = ИтРам + ОкрВверх(Строка.КвоРам);
	КонецЦикла;
	ТекущийОбъект.ИтогРамПоДокументу = ИтРам;

КонецПроцедуры // ПередЗаписьюНаСервере // + claude

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// Записываем в НачалоТермообработки реальные дату/время загрузки —
	// как в 1С77: по всем строкам ТЧ с заполненным НачалоТермообработки // + claude
	ОбработанныеДокументы = Новый Массив;

	Для Каждого Строка Из ТекущийОбъект.ТМЦ Цикл
		Если ЗначениеЗаполнено(Строка.НачалоТермообработки)
			И ОбработанныеДокументы.Найти(Строка.НачалоТермообработки) = Неопределено Тогда
			ОбработанныеДокументы.Добавить(Строка.НачалоТермообработки);
		КонецЕсли;
	КонецЦикла; // перебор строк ТМЦ

	// Документ-основание тоже обновляем, если его нет в строках
	Если ЗначениеЗаполнено(ТекущийОбъект.ДокументОснование)
		И ОбработанныеДокументы.Найти(ТекущийОбъект.ДокументОснование) = Неопределено Тогда
		ОбработанныеДокументы.Добавить(ТекущийОбъект.ДокументОснование);
	КонецЕсли; // документ-основание

	Для Каждого СсылкаНачало Из ОбработанныеДокументы Цикл
		ДокНачало = СсылкаНачало.ПолучитьОбъект();
		Если ДокНачало = Неопределено Тогда
			Продолжить;
		КонецЕсли; // документ удален
		ДокНачало.НачалоЧасы       = ТекущийОбъект.ЗагруженаЧасы;
		ДокНачало.НачалоМинуты     = ТекущийОбъект.ЗагруженаМинуты;
		ДокНачало.ДокументЗагрузка = ТекущийОбъект.Ссылка;
		ДокНачало.Записать(РежимЗаписиДокумента.Запись);
	КонецЦикла; // обновление документов НачалоТермообработки

КонецПроцедуры // ПослеЗаписиНаСервере // + claude

// ======================================================================
// Команда ОбновитьСписокСвободных — заполняет таблицу занятости камер:
// последнее состояние каждой камеры по документам за +/- 2 месяца,
// свободные камеры без документов — аналог ОбновитьСписокСвободныхКамер 1С77 // + claude
&НаКлиенте
Процедура ОбновитьСписокСвободных(Команда)
	ОбновитьСписокСвободныхНаСервере();
КонецПроцедуры // ОбновитьСписокСвободных() // + claude

&НаСервере
Процедура ОбновитьСписокСвободныхНаСервере()

	СвободныеКамеры.Очистить();

	ДатаДок    = НачалоДня(Объект.Дата);
	НачПериода = ДобавитьМесяц(ДатаДок, -2);
	КонПериода = ДобавитьМесяц(ДатаДок, 2);

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЗагрузкаКамеры.КамераТермообработки КАК Камера,
		|	ЗагрузкаКамеры.КамераТермообработки.КоличествоРам КАК Размер,
		|	ЗагрузкаКамеры.Дата КАК ЗагруженаДата,
		|	ЗагрузкаКамеры.ЗагруженаЧасы КАК ЗагруженаЧасы,
		|	ЗагрузкаКамеры.ЗагруженаМинуты КАК ЗагруженаМинуты,
		|	ЗагрузкаКамеры.СвободнаДата КАК СвободнаДата,
		|	ЗагрузкаКамеры.СвободнаЧасы КАК СвободнаЧасы,
		|	ЗагрузкаКамеры.СвободнаМинуты КАК СвободнаМинуты
		|ИЗ
		|	Документ.ЗагрузкаКамеры КАК ЗагрузкаКамеры
		|ГДЕ
		|	ЗагрузкаКамеры.Дата МЕЖДУ &НачПериода И &КонПериода
		|	И ЗагрузкаКамеры.ПометкаУдаления = ЛОЖЬ
		|	И ЗагрузкаКамеры.Ссылка <> &ТекущийДокумент
		|	И ЗагрузкаКамеры.КамераТермообработки <> ЗНАЧЕНИЕ(Справочник.КамерыТермообработки.ПустаяСсылка)
		|УПОРЯДОЧИТЬ ПО
		|	Камера,
		|	СвободнаДата УБЫВ,
		|	СвободнаЧасы УБЫВ,
		|	СвободнаМинуты УБЫВ";
	Запрос.УстановитьПараметр("НачПериода",      НачПериода);
	Запрос.УстановитьПараметр("КонПериода",      КонецДня(КонПериода));
	Запрос.УстановитьПараметр("ТекущийДокумент", Объект.Ссылка);

	Выборка = Запрос.Выполнить().Выбрать();

	ПредыдущаяКамера = Неопределено;
	Пока Выборка.Следующий() Цикл

		Если Выборка.Камера = ПредыдущаяКамера Тогда
			Продолжить;
		КонецЕсли; // берем только последнее состояние камеры
		ПредыдущаяКамера = Выборка.Камера;

		Если НачалоДня(Выборка.СвободнаДата) <= ДатаДок Тогда
			НоваяСтрока = СвободныеКамеры.Добавить();
			НоваяСтрока.Камера          = Выборка.Камера;
			НоваяСтрока.Размер          = Выборка.Размер;
			НоваяСтрока.ЗагруженаДата   = НачалоДня(Выборка.ЗагруженаДата);
			НоваяСтрока.ЗагруженаЧасы   = Выборка.ЗагруженаЧасы;
			НоваяСтрока.ЗагруженаМинуты = Выборка.ЗагруженаМинуты;
			НоваяСтрока.СвободнаДата    = НачалоДня(Выборка.СвободнаДата);
			НоваяСтрока.СвободнаЧасы    = Выборка.СвободнаЧасы;
			НоваяСтрока.СвободнаМинуты  = Выборка.СвободнаМинуты;
		КонецЕсли; // камера освободится к дате документа

	КонецЦикла; // перебор документов загрузки

	// Камеры без документов за период — свободны с даты документа
	ЗапросКамеры = Новый Запрос;
	ЗапросКамеры.Текст =
		"ВЫБРАТЬ
		|	КамерыТермообработки.Ссылка КАК Камера,
		|	КамерыТермообработки.КоличествоРам КАК Размер
		|ИЗ
		|	Справочник.КамерыТермообработки КАК КамерыТермообработки
		|ГДЕ
		|	КамерыТермообработки.ПометкаУдаления = ЛОЖЬ
		|УПОРЯДОЧИТЬ ПО
		|	КамерыТермообработки.Код";
	ВыборкаКамеры = ЗапросКамеры.Выполнить().Выбрать();

	Пока ВыборкаКамеры.Следующий() Цикл
		Если СвободныеКамеры.НайтиСтроки(Новый Структура("Камера", ВыборкаКамеры.Камера)).Количество() = 0 Тогда
			НоваяСтрока = СвободныеКамеры.Добавить();
			НоваяСтрока.Камера         = ВыборкаКамеры.Камера;
			НоваяСтрока.Размер         = ВыборкаКамеры.Размер;
			НоваяСтрока.СвободнаДата   = ДатаДок;
			НоваяСтрока.СвободнаЧасы   = 0;
			НоваяСтрока.СвободнаМинуты = 0;
		КонецЕсли; // камеры нет в таблице
	КонецЦикла; // перебор справочника камер

КонецПроцедуры // ОбновитьСписокСвободныхНаСервере() // + claude

// ======================================================================
// Выбор камеры двойным щелчком по таблице — аналог ВыбратьКамеру 1С77 // + claude
&НаКлиенте
Процедура СвободныеКамерыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.СвободныеКамеры.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли; // нет текущей строки

	Объект.КамераТермообработки = ТекущиеДанные.Камера;
	КамераТермообработкиПриИзменении_НаСервере();

КонецПроцедуры // СвободныеКамерыВыбор() // + claude

// ======================================================================
// Команда ВыбратьВремяВнутриДня — выбор свободного интервала времени
// загрузки выбранной камеры на дату документа — аналог 1С77 // + claude
&НаКлиенте
Процедура ВыбратьВремяВнутриДня(Команда)

	Если ЗначениеЗаполнено(Объект.ПодПрограмма) И НЕ ЗначениеЗаполнено(Объект.КамераТермообработки) Тогда
		Предупреждение("Выберите камеру термообработки");
		Возврат;
	КонецЕсли; // камера не выбрана

	СписокСлотов = ПолучитьСлотыВремениНаСервере();

	Если СписокСлотов.Количество() = 0 Тогда
		Предупреждение("Нет данных для выбора времени загрузки.");
		Возврат;
	КонецЕсли; // нет слотов

	СписокВыбора = Новый СписокЗначений;
	Для Индекс = 0 По СписокСлотов.Количество() - 1 Цикл
		Слот = СписокСлотов[Индекс];
		СписокВыбора.Добавить(Индекс, Слот.Представление);
	КонецЦикла; // формирование списка выбора

	ОписаниеОпов = Новый ОписаниеОповещения("ВыбратьВремяВнутриДняЗавершение", ЭтаФорма, СписокСлотов);
	СписокВыбора.ПоказатьВыборЭлемента(ОписаниеОпов, "Время загрузки камеры");

КонецПроцедуры // ВыбратьВремяВнутриДня() // + claude

&НаКлиенте
Процедура ВыбратьВремяВнутриДняЗавершение(ВыбранныйЭлемент, СписокСлотов) Экспорт

	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли; // отмена выбора

	Слот = СписокСлотов[ВыбранныйЭлемент.Значение];
	Объект.Дата            = Слот.ДатаДок;
	Объект.ЗагруженаЧасы   = Слот.Часы;
	Объект.ЗагруженаМинуты = Слот.Минуты;

	ПересчетСвободна_НаСервере();

КонецПроцедуры // ВыбратьВремяВнутриДняЗавершение() // + claude

// ======================================================================
// Список интервалов занятости камеры на дату документа со вставкой
// свободных промежутков "< Пусто >" и пометкой пересечений "+" // + claude
&НаСервере
Функция ПолучитьСлотыВремениНаСервере()

	СписокСлотов = Новый Массив;

	ДатаДок    = НачалоДня(Объект.Дата);
	НачПериода = ДобавитьМесяц(ДатаДок, -2);
	КонПериода = ДобавитьМесяц(ДатаДок, 2);

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЗагрузкаКамеры.Ссылка КАК Ссылка,
		|	ЗагрузкаКамеры.Номер КАК Номер,
		|	ЗагрузкаКамеры.Дата КАК ДатаДок,
		|	ЗагрузкаКамеры.ЗагруженаЧасы КАК ЗагруженаЧасы,
		|	ЗагрузкаКамеры.ЗагруженаМинуты КАК ЗагруженаМинуты,
		|	ЗагрузкаКамеры.СвободнаДата КАК СвободнаДата,
		|	ЗагрузкаКамеры.СвободнаЧасы КАК СвободнаЧасы,
		|	ЗагрузкаКамеры.СвободнаМинуты КАК СвободнаМинуты
		|ИЗ
		|	Документ.ЗагрузкаКамеры КАК ЗагрузкаКамеры
		|ГДЕ
		|	ЗагрузкаКамеры.Дата МЕЖДУ &НачПериода И &КонПериода
		|	И ЗагрузкаКамеры.КамераТермообработки = &Камера
		|	И ЗагрузкаКамеры.ПометкаУдаления = ЛОЖЬ
		|	И ЗагрузкаКамеры.Ссылка <> &ТекущийДокумент
		|УПОРЯДОЧИТЬ ПО
		|	ЗагрузкаКамеры.Дата,
		|	ЗагрузкаКамеры.ЗагруженаЧасы,
		|	ЗагрузкаКамеры.ЗагруженаМинуты";
	Запрос.УстановитьПараметр("НачПериода",      НачПериода);
	Запрос.УстановитьПараметр("КонПериода",      КонецДня(КонПериода));
	Запрос.УстановитьПараметр("Камера",          Объект.КамераТермообработки);
	Запрос.УстановитьПараметр("ТекущийДокумент", Объект.Ссылка);

	Выборка = Запрос.Выполнить().Выбрать();

	// Отбираем документы на дату документа и соседние дни (как 1С77)
	ТаблицаИнтервалов = Новый ТаблицаЗначений;
	ТаблицаИнтервалов.Колонки.Добавить("Наименование");
	ТаблицаИнтервалов.Колонки.Добавить("ДатаДок");
	ТаблицаИнтервалов.Колонки.Добавить("ЗагруженаЧасы");
	ТаблицаИнтервалов.Колонки.Добавить("ЗагруженаМинуты");
	ТаблицаИнтервалов.Колонки.Добавить("СвободнаДата");
	ТаблицаИнтервалов.Колонки.Добавить("СвободнаЧасы");
	ТаблицаИнтервалов.Колонки.Добавить("СвободнаМинуты");

	Пока Выборка.Следующий() Цикл
		ДатаСтроки = НачалоДня(Выборка.ДатаДок);
		Если ДатаСтроки = ДатаДок
			ИЛИ (ДатаСтроки < ДатаДок И НачалоДня(Выборка.СвободнаДата) >= ДатаДок)
			ИЛИ ДатаСтроки + 86400 = ДатаДок
			ИЛИ ДатаСтроки - 86400 = ДатаДок Тогда
			НоваяСтрока = ТаблицаИнтервалов.Добавить();
			НоваяСтрока.Наименование    = "№" + Выборка.Номер + " от " + Формат(Выборка.ДатаДок, "ДФ=dd.MM.yy");
			НоваяСтрока.ДатаДок         = ДатаСтроки;
			НоваяСтрока.ЗагруженаЧасы   = Выборка.ЗагруженаЧасы;
			НоваяСтрока.ЗагруженаМинуты = Выборка.ЗагруженаМинуты;
			НоваяСтрока.СвободнаДата    = НачалоДня(Выборка.СвободнаДата);
			НоваяСтрока.СвободнаЧасы    = Выборка.СвободнаЧасы;
			НоваяСтрока.СвободнаМинуты  = Выборка.СвободнаМинуты;
		КонецЕсли; // документ актуален для даты
	КонецЦикла; // перебор документов камеры

	// Вставляем свободные промежутки "< Пусто >" между интервалами
	ТекЧасы   = 0;
	ТекМинуты = 0;
	ТекДатаСвободна = ДатаДок;

	Для Каждого СтрокаИнт Из ТаблицаИнтервалов Цикл

		ТекМинутыВсего       = ТекЧасы * 60 + ТекМинуты;
		ТекМинутыВсегоСтрока = СтрокаИнт.ЗагруженаЧасы * 60 + СтрокаИнт.ЗагруженаМинуты;

		Если ТекМинутыВсего < ТекМинутыВсегоСтрока И СтрокаИнт.ДатаДок = ДатаДок Тогда
			ДобавитьСлот(СписокСлотов, "< Пусто >", ДатаДок, ТекЧасы, ТекМинуты);
		КонецЕсли; // свободный промежуток

		ДобавитьСлот(СписокСлотов, СтрокаИнт.Наименование, СтрокаИнт.ДатаДок,
			СтрокаИнт.ЗагруженаЧасы, СтрокаИнт.ЗагруженаМинуты);

		ТекЧасы         = СтрокаИнт.СвободнаЧасы;
		ТекМинуты       = СтрокаИнт.СвободнаМинуты;
		ТекДатаСвободна = СтрокаИнт.СвободнаДата;

		Если СтрокаИнт.СвободнаДата > ДатаДок Тогда
			Прервать;
		КонецЕсли; // за пределами даты документа

	КонецЦикла; // перебор интервалов

	// Последняя строчка — свободное время после всех загрузок
	Если ТекДатаСвободна = ДатаДок Тогда
		ДобавитьСлот(СписокСлотов, "< Пусто >", ДатаДок, ТекЧасы, ТекМинуты);
	ИначеЕсли ТекДатаСвободна < ДатаДок Тогда
		ДобавитьСлот(СписокСлотов, "< Пусто >", ДатаДок, 0, 0);
	КонецЕсли; // последний свободный промежуток

	Возврат СписокСлотов;

КонецФункции // ПолучитьСлотыВремениНаСервере() // + claude

&НаСервереБезКонтекста
Процедура ДобавитьСлот(СписокСлотов, Наименование, ДатаДок, Часы, Минуты)

	Слот = Новый Структура;
	Слот.Вставить("Представление", Наименование + "  " + Формат(ДатаДок, "ДФ=dd.MM.yy")
		+ " " + Формат(Часы, "ЧЦ=2; ЧВН=; ЧГ=") + ":" + Формат(Минуты, "ЧЦ=2; ЧВН=; ЧГ="));
	Слот.Вставить("ДатаДок", ДатаДок);
	Слот.Вставить("Часы",    Часы);
	Слот.Вставить("Минуты",  Минуты);
	СписокСлотов.Добавить(Слот);

КонецПроцедуры // ДобавитьСлот() // + claude

// Печать терможурнала по текущему документу.
// Аналог Печать() формы УМК_ЗагрузкаКамеры 1С77: запись документа и
// открытие обработки УМК_ПечатьТерможурнала со списком документов. // + claude
&НаКлиенте
Процедура ПечатьТерможурнала(Команда)

	// 1С77 выполнял Записать() перед печатью
	Если Модифицированность Или НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Если НЕ Записать() Тогда
			Возврат;
		КонецЕсли; // запись не выполнена
	КонецЕсли; // документ не записан

	СписокДокументов = Новый Массив;
	СписокДокументов.Добавить(Объект.Ссылка);

	ПараметрыФормы = Новый Структура("СписокДокументов", СписокДокументов);
	ОткрытьФорму("Обработка.ПечатьТерможурнала.Форма.ФормаУФ", ПараметрыФормы, ЭтаФорма);

КонецПроцедуры // ПечатьТерможурнала // + claude
