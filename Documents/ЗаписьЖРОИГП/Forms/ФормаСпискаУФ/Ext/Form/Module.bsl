
// ======================================================================
// Команда ЗаполнитьНаОснованииОПЗ — выбор периода и создание документов
// ЗаписьЖРОИГП на основании проведенных Отчетов производства за смену.
// Аналог ЗаполнитьНачалоТермообработки в журнале НачалоТермообработки. // + claude
&НаКлиенте
Процедура ЗаполнитьНаОснованииОПЗ(Команда)

	ДиалогПериода = Новый ДиалогРедактированияСтандартногоПериода;
	ДиалогПериода.Период = Новый СтандартныйПериод();
	ДиалогПериода.Период.ДатаНачала    = ТекущаяДата();
	ДиалогПериода.Период.ДатаОкончания = ТекущаяДата();
	ДиалогПериода.Показать(Новый ОписаниеОповещения("ЗаполнитьНаОснованииОПЗПродолжение", ЭтаФорма));

КонецПроцедуры // ЗаполнитьНаОснованииОПЗ()

// ======================================================================
// Обработчик выбора периода — вызывается после закрытия диалога выбора периода // + claude
&НаКлиенте
Процедура ЗаполнитьНаОснованииОПЗПродолжение(ВыбранныйПериод, ДопПараметры) Экспорт

	Если ВыбранныйПериод = Неопределено Тогда
		Возврат;
	КонецЕсли; // отмена выбора периода

	СписокОПЗ = ПолучитьСписокОПЗНаСервере(ВыбранныйПериод.ДатаНачала, ВыбранныйПериод.ДатаОкончания);

	Если СписокОПЗ.Количество() = 0 Тогда
		Предупреждение("Не найдено проведенных Отчетов производства за смену за указанный период.");
		Возврат;
	КонецЕсли; // нет отчетов за период

	Контекст = Новый Структура;
	Контекст.Вставить("СписокОПЗ", СписокОПЗ);
	Контекст.Вставить("Индекс", 0);

	ОбработатьСледующийОПЗ(Контекст);

КонецПроцедуры // ЗаполнитьНаОснованииОПЗПродолжение()

// ======================================================================
// Перебирает отчеты производства: по отчетам с существующими документами
// ЗаписьЖРОИГП задает вопрос об удалении, остальные помечает к созданию // + claude
&НаКлиенте
Процедура ОбработатьСледующийОПЗ(Контекст)

	Пока Контекст.Индекс < Контекст.СписокОПЗ.Количество() Цикл

		ТекЭлемент = Контекст.СписокОПЗ[Контекст.Индекс];

		Если ТекЭлемент.СуществующиеДокументы.Количество() > 0 Тогда
			ТекстВопроса = "На основании документа """ + ТекЭлемент.ПредставлениеОПЗ
				+ """ уже создан документ ЗаписьЖРОИГП: " + ТекЭлемент.ПредставлениеСуществующих
				+ Символы.ПС + "Удалить его и создать новый?";
			ПоказатьВопрос(Новый ОписаниеОповещения("ОбработатьОтветУдаления", ЭтаФорма, Контекст),
				ТекстВопроса, РежимДиалогаВопрос.ДаНет);
			Возврат;
		Иначе
			ТекЭлемент.Создавать = Истина;
			Контекст.Индекс = Контекст.Индекс + 1;
		КонецЕсли; // есть существующие документы

	КонецЦикла; // перебор списка ОПЗ

	ЗавершитьЗаполнение(Контекст);

КонецПроцедуры // ОбработатьСледующийОПЗ()

// ======================================================================
// Обработчик ответа на вопрос об удалении существующего документа:
// Да — удаляем и создаем новый, Нет — пропускаем, новый не создаем // + claude
&НаКлиенте
Процедура ОбработатьОтветУдаления(РезультатВопроса, Контекст) Экспорт

	ТекЭлемент = Контекст.СписокОПЗ[Контекст.Индекс];

	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ТекЭлемент.УдалятьСуществующие = Истина;
		ТекЭлемент.Создавать           = Истина;
	Иначе
		ТекЭлемент.УдалятьСуществующие = Ложь;
		ТекЭлемент.Создавать           = Ложь;
	КонецЕсли; // ответ пользователя

	Контекст.Индекс = Контекст.Индекс + 1;
	ОбработатьСледующийОПЗ(Контекст);

КонецПроцедуры // ОбработатьОтветУдаления()

// ======================================================================
// Завершение: создание документов на сервере и вывод результата // + claude
&НаКлиенте
Процедура ЗавершитьЗаполнение(Контекст)

	Результат = СоздатьДокументыНаСервере(Контекст.СписокОПЗ);

	Если Результат.Ошибка Тогда
		Предупреждение(Результат.Сообщение);
	КонецЕсли; // есть ошибки

	Состояние("Создано документов ЗаписьЖРОИГП: " + Результат.Создано
		+ ?(Результат.Пропущено > 0, ", пропущено: " + Результат.Пропущено, ""));
	Элементы.Список.Обновить();

КонецПроцедуры // ЗавершитьЗаполнение()

// ======================================================================
// Возвращает массив структур по проведенным ОтчетПроизводстваЗаСмену за период:
// ОтчетПроизводства, ПредставлениеОПЗ, СуществующиеДокументы (массив ссылок
// ЗаписьЖРОИГП, созданных на основании), ПредставлениеСуществующих,
// Создавать, УдалятьСуществующие // + claude
&НаСервереБезКонтекста
Функция ПолучитьСписокОПЗНаСервере(НачалоПериода, КонецПериода)

	СписокОПЗ = Новый Массив;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ОПЗ.Ссылка КАК ОтчетПроизводства,
		|	ЗаписьЖРОИГП.Ссылка КАК СуществующийДокумент
		|ИЗ
		|	Документ.ОтчетПроизводстваЗаСмену КАК ОПЗ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаписьЖРОИГП КАК ЗаписьЖРОИГП
		|		ПО ЗаписьЖРОИГП.ОтчетПроизводства = ОПЗ.Ссылка
		|			И ЗаписьЖРОИГП.ПометкаУдаления = ЛОЖЬ
		|ГДЕ
		|	ОПЗ.Дата >= &НачалоПериода
		|	И ОПЗ.Дата <= &КонецПериода
		|	И ОПЗ.Проведен = ИСТИНА
		|УПОРЯДОЧИТЬ ПО
		|	ОПЗ.Дата,
		|	ОПЗ.Ссылка";
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(НачалоПериода));
	Запрос.УстановитьПараметр("КонецПериода",  КонецДня(КонецПериода));

	Выборка = Запрос.Выполнить().Выбрать();

	ТекущийЭлемент = Неопределено;
	Пока Выборка.Следующий() Цикл

		Если ТекущийЭлемент = Неопределено
			ИЛИ ТекущийЭлемент.ОтчетПроизводства <> Выборка.ОтчетПроизводства Тогда
			ТекущийЭлемент = Новый Структура;
			ТекущийЭлемент.Вставить("ОтчетПроизводства",         Выборка.ОтчетПроизводства);
			ТекущийЭлемент.Вставить("ПредставлениеОПЗ",          Строка(Выборка.ОтчетПроизводства));
			ТекущийЭлемент.Вставить("СуществующиеДокументы",     Новый Массив);
			ТекущийЭлемент.Вставить("ПредставлениеСуществующих", "");
			ТекущийЭлемент.Вставить("Создавать",                 Ложь);
			ТекущийЭлемент.Вставить("УдалятьСуществующие",       Ложь);
			СписокОПЗ.Добавить(ТекущийЭлемент);
		КонецЕсли; // новый отчет производства

		Если ЗначениеЗаполнено(Выборка.СуществующийДокумент) Тогда
			ТекущийЭлемент.СуществующиеДокументы.Добавить(Выборка.СуществующийДокумент);
			ТекущийЭлемент.ПредставлениеСуществующих = ТекущийЭлемент.ПредставлениеСуществующих
				+ ?(ТекущийЭлемент.ПредставлениеСуществующих = "", "", ", ")
				+ Строка(Выборка.СуществующийДокумент);
		КонецЕсли; // есть существующий документ

	КонецЦикла; // перебор выборки

	Возврат СписокОПЗ;

КонецФункции // ПолучитьСписокОПЗНаСервере()

// ======================================================================
// Создает документы ЗаписьЖРОИГП по отмеченным элементам списка.
// Существующие документы удаляет только при согласии пользователя.
// Возвращает структуру: Ошибка, Сообщение, Создано, Пропущено // + claude
&НаСервереБезКонтекста
Функция СоздатьДокументыНаСервере(СписокОПЗ)

	Результат = Новый Структура("Ошибка, Сообщение, Создано, Пропущено", Ложь, "", 0, 0);

	Для Каждого Элемент Из СписокОПЗ Цикл

		Если НЕ Элемент.Создавать Тогда
			Если Элемент.СуществующиеДокументы.Количество() > 0 Тогда
				Результат.Пропущено = Результат.Пропущено + 1;
			КонецЕсли; // пропущен по отказу пользователя
			Продолжить;
		КонецЕсли; // не создавать

		Попытка

			// Удаляем существующие документы по согласию пользователя
			Если Элемент.УдалятьСуществующие Тогда
				Для Каждого СсылкаДок Из Элемент.СуществующиеДокументы Цикл
					ДокУдаление = СсылкаДок.ПолучитьОбъект();
					Если ДокУдаление = Неопределено Тогда
						Продолжить;
					КонецЕсли; // документ уже удален
					Если ДокУдаление.Проведен Тогда
						ДокУдаление.Записать(РежимЗаписиДокумента.ОтменаПроведения);
					КонецЕсли; // отмена проведения перед удалением
					ДокУдаление.Удалить();
				КонецЦикла; // перебор существующих документов
			КонецЕсли; // удалять существующие

			// Создаем новый документ на основании — вызывается ОбработкаЗаполнения
			НовыйДок = Документы.ЗаписьЖРОИГП.СоздатьДокумент();
			НовыйДок.Заполнить(Элемент.ОтчетПроизводства);
			НовыйДок.Записать(РежимЗаписиДокумента.Запись);

			Результат.Создано = Результат.Создано + 1;

		Исключение
			Результат.Ошибка   = Истина;
			Результат.Сообщение = Результат.Сообщение
				+ "Ошибка по документу " + Элемент.ПредставлениеОПЗ + ": "
				+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + Символы.ПС;
		КонецПопытки;

	КонецЦикла; // перебор списка ОПЗ

	Возврат Результат;

КонецФункции // СоздатьДокументыНаСервере()
