
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)

	Если ПараметрКоманды.Количество() = 0 Тогда
		Сообщить("Не выбрано ни одного документа, печать невозможна!");
		Возврат;
	КонецЕсли; // ничего не выбрано // + claude

	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.ИмяПараметровПечати = "ПЕЧАТЬ_ДекЛист";

	СформироватьДекЛист(ТабДокумент, ПараметрКоманды);

	ТабДокумент.ОтображатьСетку = Ложь;
	ТабДокумент.Защита = Истина;
	ТабДокумент.ТолькоПросмотр = Ложь;
	ТабДокумент.ОтображатьЗаголовки = Ложь;
	ТабДокумент.Показать();

КонецПроцедуры

&НаСервере
Процедура СформироватьДекЛист(ТабДокумент, МассивСсылок)
	Документы.ЗаписьЖРОИГП.СформироватьДекЛист(ТабДокумент, МассивСсылок, "К"); // "К" = Кладовщик // + claude
КонецПроцедуры
